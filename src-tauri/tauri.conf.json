{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "z-monitor",
  "version": "0.1.0",
  "identifier": "com.cryanskl.z-monitor",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://127.0.0.1:1427",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "macOSPrivateApi": true,
    "windows": [
      {
        "label": "main",
        "title": "z-monitor",
        "width": 400,
        "height": 768,
        "minWidth": 400,
        "minHeight": 768,
        "resizable": false,
        "transparent": true,
        "decorations": false,
        "backgroundColor": "#00000000",
        "center": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:; connect-src ipc: http://ipc.localhost http://127.0.0.1:1427 ws://127.0.0.1:1427"
    }
  },
  "bundle": {
    "active": true,
    "targets": ["app", "dmg"],
    "resources": ["binaries/monitor"],
    "icon": ["icons/32x32.png", "icons/128x128.png", "icons/icon.icns"],
    "macOS": { "minimumSystemVersion": "13.0", "signingIdentity": "-" }
  }
}
